{
  "name": "report-engine-mvp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner && npm run check:bundle",
    "lint": "oxlint",
    "preview": "vite preview --configLoader runner",
    "mcp": "tsx src/mcp/index.ts",
    "server": "tsx src/server/standalone.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:mcp": "tsx scripts/test_mcp_e2e.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:mcp && npm run test:pdf && npm run build && npm run build:package && npm run test:package && npm run test:e2e",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "check:bundle": "tsx scripts/check_bundle.ts",
    "build:package": "vite build --config vite.package.config.ts --configLoader runner && tsc -p tsconfig.package.json && tsx scripts/finish_package.ts",
    "test:pdf": "tsx scripts/pdf_regression.ts",
    "test:pdf:update": "tsx scripts/pdf_regression.ts --update",
    "test:package": "tsx scripts/test_package.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/noto-sans-tc": "^5.3.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@react-pdf/renderer": "^4.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.60.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@playwright/test": "^1.64.1",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "pdfjs-dist": "^6.4.299",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
